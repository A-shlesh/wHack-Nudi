# Copy this file to .env and fill in what you have.
# Anything left empty runs in MOCK mode, so the demo always works.

# --- AI (page help, questions, "Explain this", family weekly note) ---
# Nudi tries them in this order and skips any without a key.
# None set = offline mode with Nudi's own rules (the demo still works).
AI_ORDER=gemini,groq,bedrock

# Gemini (main, free tier). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Optional. Default: gemini-3.5-flash-lite. Check your free-tier models in AI Studio.
GEMINI_MODEL=

# Groq (backup, free limits). Get a key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
# Optional. Default: openai/gpt-oss-20b. Check your limits at console.groq.com/settings/limits.
GROQ_MODEL=

# --- AWS Bedrock (optional third AI) ---
# Either normal AWS keys...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ...or a Bedrock API key:
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# us. profile for US regions; from Mumbai (ap-south-1) use global.anthropic.claude-haiku-5-5
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5

# --- ElevenLabs (natural voice) ---
ELEVENLABS_API_KEY=
# Pick a voice id from your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
# Optional. eleven_v4_turbo is the default (fast, supports Kannada and Hindi).
ELEVENLABS_MODEL_ID=

# --- Family Link storage ---
# Empty = a local SQLite file (backend/nudi.db).
# Set all three (plus AWS keys) to use DynamoDB instead. On AWS Lambda the
# SAM template sets these for you.
FAMILIES_TABLE=
EVENTS_TABLE=
APPROVALS_TABLE=
