# Copy this file to .env and fill in what you have.
# Anything left empty runs in MOCK mode, so the demo always works.

# --- AWS Bedrock (AI that simplifies pages) ---
# Either normal AWS keys...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ...or a Bedrock API key:
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# us. profile for US regions; from Mumbai (ap-south-1) use global.anthropic.claude-haiku-5-5
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5

# --- ElevenLabs (natural voice) ---
ELEVENLABS_API_KEY=
# Pick a voice id from your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=
# Optional. eleven_v4_turbo is the default (fast, supports Kannada and Hindi).
ELEVENLABS_MODEL_ID=

# --- Family Link storage ---
# Empty = a local SQLite file (backend/nudi.db).
# Set all three (plus AWS keys) to use DynamoDB instead. On AWS Lambda the
# SAM template sets these for you.
FAMILIES_TABLE=
EVENTS_TABLE=
APPROVALS_TABLE=
