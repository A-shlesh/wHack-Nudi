{
  "manifest_version": 3,
  "name": "Nudi - Simple Web Helper",
  "version": "0.2.0",
  "description": "Turns busy websites into a few big, simple buttons. Warns about scams. Always asks before you pay.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Nudi: help me with this page (Alt+Shift+N)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-nudi": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open Nudi on this page"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
